{
  "name": "world-cup-oracle",
  "version": "1.0.0",
  "description": "World Cup Oracle Application Suite",
  "private": true,
  "workspaces": [
    "packages/shared",
    "backend",
    "wcp-web"
  ],
  "scripts": {
    "predev": "npm run build:shared",
    "dev:backend": "npm --workspace wcp-api run dev",
    "dev:frontend": "npm --workspace wcp-web run dev",
    "dev": "concurrently --kill-others -n \"api,web\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:shared": "npm --workspace @wco/shared run build",
    "test": "npm --workspace @wco/shared test && npm --workspace wcp-api test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
