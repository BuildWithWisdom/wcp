# Server
PORT=3001
NODE_ENV=development

# Comma-separated CORS allowlist (defaults to localhost:5173,localhost:3000)
CORS_ORIGIN=http://localhost:5173

# Google Gemini AI key for Oracle tactical commentary (optional — falls back to neutral modifiers)
GEMINI_API_KEY=

# football-data.org API token for fixture sync (optional — sync stays disabled without it)
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# SQLite database path (defaults to backend/data/app.db)
DATABASE_PATH=

# Fixture sync cadence (milliseconds). Defaults: TTL 10 min, interval 15 min.
SYNC_TTL_MS=
SYNC_INTERVAL_MS=
